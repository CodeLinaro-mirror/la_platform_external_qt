QMAKE_TARGET  = QtGui
DESTDIR       = ../../lib/
TARGET        = libQtGui.4.7.4.dylib
TARGETA       = ../../lib/libQtGui.a
TARGETD       = libQtGui.4.7.4.dylib
TARGET0       = libQtGui.dylib
TARGET1       = libQtGui.4.dylib
TARGET2       = libQtGui.4.7.dylib

####### Custom Compiler Variables
QMAKE_COMP_QMAKE_OBJECTIVE_CFLAGS = -pipe \
		-Xarch_i386 \
		-mmacosx-version-min=10.4 \
		-Xarch_ppc \
		-mmacosx-version-min=10.4 \
		-O2 \
		-arch \
		i386 \
		-fvisibility=hidden \
		-fvisibility-inlines-hidden \
		-Wall \
		-W \
		-arch \
		ppc


first: all
####### Implicit rules

.SUFFIXES: .o .c .mm .cpp .cc .cxx .C

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o "$@" "$<"

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o "$@" "$<"

.mm.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o "$@" "$<"

####### Build rules

all: Makefile.Release ../../lib/libQtGui.prl ../../lib/libQtGui.la ../../lib/pkgconfig/QtGui.pc  ../../lib/$(TARGET)

../../lib/$(TARGET): .uic/release-shared/ui_qfiledialog.h .uic/release-shared/ui_qpagesetupwidget.h $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@$(CHK_DIR_EXISTS) ../../lib/ || $(MKDIR) ../../lib/ 
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../lib/$(TARGET)
	-$(DEL_FILE) ../../lib/$(TARGET0)
	-$(DEL_FILE) ../../lib/$(TARGET1)
	-$(DEL_FILE) ../../lib/$(TARGET2)
	-$(MOVE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2) ../../lib/



staticlib: $(TARGETA)

$(TARGETA): .uic/release-shared/ui_qfiledialog.h .uic/release-shared/ui_qpagesetupwidget.h $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)
	$(RANLIB) $(TARGETA)

../../lib/libQtGui.prl: 
	@$(QMAKE) -prl  -spec ../../mkspecs/macx-g++42 gui.pro
qmake:  FORCE
	@$(QMAKE) -spec ../../mkspecs/macx-g++42 -o Makefile.Release gui.pro

dist: 
	@$(CHK_DIR_EXISTS) .obj/release-shared/QtGui4.7.4 || $(MKDIR) .obj/release-shared/QtGui4.7.4 
	$(COPY_FILE) --parents $(SOURCES) $(DIST) .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents dialogs/qcolordialog_mac.mm .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents painting/qdrawhelper_mmx.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents painting/qdrawhelper_mmx3dnow.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents painting/qdrawhelper_sse3dnow.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents painting/qdrawhelper_sse.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents image/qimage_sse2.cpp painting/qdrawhelper_sse2.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents image/qimage_ssse3.cpp painting/qdrawhelper_ssse3.cpp .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents kernel/qcursor_mac.mm kernel/qdnd_mac.mm kernel/qsound_mac.mm kernel/qapplication_mac.mm kernel/qwidget_mac.mm kernel/qcocoapanel_mac.mm kernel/qcocoaview_mac.mm kernel/qcocoawindow_mac.mm kernel/qcocoawindowdelegate_mac.mm kernel/qcocoamenuloader_mac.mm kernel/qcocoaapplication_mac.mm kernel/qcocoaapplicationdelegate_mac.mm kernel/qt_cocoa_helpers_mac.mm kernel/qdesktopwidget_mac.mm kernel/qeventdispatcher_mac.mm kernel/qcocoawindowcustomthemeframe_mac.mm kernel/qmacgesturerecognizer_mac.mm kernel/qmultitouch_mac.mm painting/qprintengine_mac.mm text/qfontengine_mac.mm styles/qmacstyle_mac.mm widgets/qmenu_mac.mm widgets/qmaccocoaviewcontainer_mac.mm widgets/qcocoatoolbardelegate_mac.mm widgets/qmainwindowlayout_mac.mm widgets/qmacnativewidget_mac.mm widgets/qcocoamenu_mac.mm dialogs/qfiledialog_mac.mm dialogs/qfontdialog_mac.mm dialogs/qnspanelproxy_mac.mm dialogs/qpagesetupdialog_mac.mm dialogs/qprintdialog_mac.mm accessible/qaccessible_mac.mm accessible/qaccessible_mac_cocoa.mm util/qsystemtrayicon_mac.mm .obj/release-shared/QtGui4.7.4/ && $(COPY_FILE) --parents kernel/qaction.h kernel/qaction_p.h kernel/qactiongroup.h kernel/qapplication.h kernel/qapplication_p.h kernel/qboxlayout.h kernel/qclipboard.h kernel/